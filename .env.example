# Copy to .env.local (development) or set in your host's build settings.
# All values are public: NEXT_PUBLIC_* variables are written into the static
# HTML/JS at build time. Never put secrets here.

# Canonical site origin used for canonical URLs, Open Graph URLs, sitemap and
# robots. Defaults to https://www.therhynd.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.therhynd.com

# Set to "true" on the production build only. Any other value (or unset)
# makes robots.txt disallow crawling, so previews are not indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Formspree endpoints, one per form (https://formspree.io/f/<form-id>).
# Leave a value empty and that form shows "online sending isn't connected"
# with the estate's email/phone instead of pretending to send.
NEXT_PUBLIC_FORM_CONTACT_ENDPOINT=
NEXT_PUBLIC_FORM_NEWSLETTER_ENDPOINT=
# Brochure request form (Download our brochure, Pricing, Weddings, Barn weddings)
NEXT_PUBLIC_FORM_BROCHURE_ENDPOINT=
# Book a viewing
NEXT_PUBLIC_FORM_VIEWING_ENQUIRY_ENDPOINT=
# Wild weddings "Get in touch" form
NEXT_PUBLIC_FORM_WEDDING_ENQUIRY_ENDPOINT=
# Book a table
NEXT_PUBLIC_FORM_TABLE_ENQUIRY_ENDPOINT=
# Event ticket requests (/events/<slug>)
NEXT_PUBLIC_FORM_EVENT_TICKETS_ENDPOINT=
